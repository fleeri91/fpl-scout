# --- App login (NextAuth / Auth.js) ---
# Gates access to FPL Scout itself. No database — sessions are JWT-based.

# Required by Auth.js to sign session tokens. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth app credentials (console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect
# URI for local dev (and your deployed URL's equivalent in production).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The single allowed account for email+password login — there's no signup.
# AUTH_PASSWORD_HASH is a bcrypt hash, never the plaintext password.
# Generate one with: npx bcrypt "your-password"
#
# IMPORTANT: Next.js expands $VAR / ${VAR} in .env files, and bcrypt hashes
# are full of literal `$` (e.g. $2b$10$...). Escape every `$` in the hash as
# `\$` or Next.js will silently truncate it at the first one, e.g.:
#   AUTH_PASSWORD_HASH=\$2b\$10\$6c5Uh6lQUH.7aiXPuoQ/Su0sWLydVOMTTPZX58x9pytjPiYq1wE5K
AUTH_EMAIL=
AUTH_PASSWORD_HASH=

# --- FPL account connection (separate from the app login above) ---
# No configuration needed — the /api/fpl/login route proxies straight to
# FPL's own login endpoint and stores only the resulting session cookie.
